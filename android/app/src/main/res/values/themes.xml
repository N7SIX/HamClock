<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for API 17+. Only attributes that exist on old platforms live
         here; API 21+ bar colors and API 28+ cutout mode are layered in
         values-v21 / values-v28 so Android 4.x never has to parse them. -->
    <style name="Theme.N7SIXHamClock" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <!-- Full-bleed wall clock: no title, fullscreen. -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
